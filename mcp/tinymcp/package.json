{
  "name": "@limbo/tinymcp",
  "version": "2.1.1",
  "description": "TinyPNG 官方 API 图片压缩 MCP + CLI（tinymcp）",
  "type": "module",
  "bin": {
    "tinymcp": "dist/tinymcp-cli.cjs",
    "tinymcp-server": "dist/tinymcp.cjs"
  },
  "main": "src/core.js",
  "exports": "./src/core.js",
  "files": [
    "dist",
    "src",
    "bin",
    "README.md",
    "DISCLAIMER.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/tinymcp-cli.cjs",
    "mcp": "node dist/tinymcp.cjs",
    "dev:mcp": "node src/mcp.js",
    "dev:cli": "node bin/cli.js"
  },
  "keywords": [
    "tinymcp",
    "tinypng",
    "mcp",
    "image",
    "compress"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "tinify": "^1.8.1",
    "zod": "^4.4.3"
  }
}
